{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "路段最终决策",
  "description": "路段分析完成且朋友投票汇总后生成的最终保留、待定或淘汰决策。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tripId", "segmentId", "segmentAnalysisAnalyzedAt", "status", "decidedAt", "voteSummary", "decisions"],
  "properties": {
    "schemaVersion": { "const": "1.0", "description": "最终决策格式版本。" },
    "tripId": { "type": "string", "minLength": 1 },
    "segmentId": { "type": "string", "minLength": 1 },
    "segmentAnalysisAnalyzedAt": { "type": "string", "format": "date", "description": "本决策引用的路段分析日期。" },
    "status": { "enum": ["waiting_for_votes", "decided", "stale"] },
    "decidedAt": { "type": ["string", "null"], "format": "date" },
    "voteSummary": { "$ref": "#/$defs/voteSummary" },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "voteSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["participantCount", "destinationResults"],
      "properties": {
        "participantCount": { "$ref": "#/$defs/count" },
        "destinationResults": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["destinationId", "counts", "averageScore"],
            "properties": {
              "destinationId": { "type": "string", "minLength": 1 },
              "counts": {
                "type": "object", "additionalProperties": false,
                "required": ["love", "okay", "neutral", "skip"],
                "properties": {
                  "love": { "$ref": "#/$defs/count" },
                  "okay": { "$ref": "#/$defs/count" },
                  "neutral": { "$ref": "#/$defs/count" },
                  "skip": { "$ref": "#/$defs/count" }
                }
              },
              "averageScore": { "type": ["number", "null"], "minimum": 0, "maximum": 3 }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["destinationId", "grade", "recommendation", "summary", "reasons"],
      "properties": {
        "destinationId": { "type": "string", "minLength": 1 },
        "grade": { "enum": ["A", "B", "C", "D"] },
        "recommendation": { "enum": ["keep", "hold", "drop"] },
        "summary": { "type": "string", "minLength": 1 },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
